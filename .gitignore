# ── Whitelist mode (inverse ignore): ignore everything by default, only track explicitly allowed paths ──────────
# Anything new added to the repo is not pushed unless explicitly allowed here.
# Already-tracked files are unaffected by .gitignore; use `git rm --cached` to untrack.

# 1) Ignore all
*

# 2) Allow root files (project entry)
!.gitignore
!README.md

# 3) Allow sing-box subproject (whole subtree; add a line per new category)
!sing-box/
!sing-box/**

# 3b) Allow share subproject (one-time file sharing)
!share/
!share/**

# 3c) Allow config-delivery (thin dufs wrapper script; binaries excluded below)
!config-delivery/
!config-delivery/**

# 3c-b) Allow duck-ddns (DuckDNS A/AAAA dynamic updater for the home box)
!duck-ddns/
!duck-ddns/**

# 3d) Allow repo-level tooling (git hooks)
!scripts/
!scripts/**

# 3e) Allow builds (cross-compiled server artifacts + build provenance)
!builds/
!builds/**
# Build artifacts inside builds/ (regenerated, never tracked)
builds/h2o-share/

# 3f) Allow source code (magdns Rust + stage tests)
!src/
!src/**
src/dnsdist/target*/
src/dnsdist/pgo-data*/

# 3g) Allow deployment configs (systemd units, config examples)
!deploy/
!deploy/**

# 3h) Allow patches
!patches/
!patches/**

# 3i) Allow docs
!docs/
!docs/**

# 3j) Allow notes
!notes/
!notes/**

# 4) Local exclusions (sensitive/generated; note: gitignore has no inline comments — keep them on their own line)
# Generated configs & keys (incl. server private keys), never upload
sing-box/out/
# Test fake keys generated by setup.sh (regenerable)
sing-box/test-env/secrets/
# Self-signed test cert/private key (regenerated by setup.sh)
sing-box/test-env/server/hy2.crt
sing-box/test-env/server/hy2.key
# Test server config (setup.sh generated, contains local absolute paths, not tracked)
sing-box/test-env/server/config.json
# Test artifacts
sing-box/test-env/client/
# Test sing-box binary + libcronet.so (79MB+12MB, downloaded, never tracked)
sing-box/test-env/bin/
# Default client output (generated in scripts/ dir, contains server keys)
sing-box/scripts/config-client.json
# Server config generated by gen-server.sh (contains ALL credentials, never upload)
sing-box/scripts/config-server.json
# Python bytecode cache (otd.py in share/)
share/__pycache__/
# Mimosa scan bookkeeping dirs are never tracked
.mimosa/
# Archived otd.py (kept for reference; old one-time sharing, superseded by config-delivery)
archived/
# config-delivery built binaries (source tracked, cross-compiled artifacts are downloads)
config-delivery/config-delivery
config-delivery/config-delivery-linux-amd64
config-delivery/config-delivery-linux-arm64
src/dnsdist/stage/certs/*.key
src/dnsdist/stage/run/
src/dnsdist/stage/__pycache__/
