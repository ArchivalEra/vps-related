{
  "log": { "level": "warn" },
  "dns": {
    "servers": [
      { "tag": "local", "address": "local", "strategy": "ipv4_only" }
    ],
    "disable_cache": true,
    "disable_expire": false,
    "independent_cache": false
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "reality",
      "listen": "::",
      "listen_port": 8443,
      "users": [
        {
          "uuid": "REPLACE_WITH_gen-server_sh_output_uuid",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.baidu.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.baidu.com",
            "server_port": 443
          },
          "private_key": "REPLACE_WITH_gen-server_sh_output_private_key",
          "short_id": ["REPLACE_WITH_gen-server_sh_output_short_id"]
        }
      }
    }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": { "default_domain_resolver": { "server": "local" } }
}
