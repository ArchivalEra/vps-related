[Unit]
Description=sing-box (reality server, vless + cache-less DNS)
Documentation=file:/home/archivalera/plum/zcode-projects/vps-related/builds/sing-box/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box/config.json
# GC: VLESS+Reality on 1G box (A53/1G/8G) must stay ≤50M; qemu stage proved 45MiB soft limit + GOGC=20 holds
Environment=GOGC=20
Environment=GOMEMLIMIT=45MiB
User=sing-box
Group=sing-box
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
LimitNOFILE=65535
MemoryMax=90M
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
