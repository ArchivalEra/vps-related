[Unit]
Description=magdns private DoT/DoQ relay
Documentation=file:/home/archivalera/plum/zcode-projects/vps-related/builds/dnsdist/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/magdns -c /etc/magdns/magdns.conf
# SIGHUP = hot certificate reload (no restart, no dropped connections)
ExecReload=/bin/kill -HUP $MAINPID
User=magdns
Group=magdns
# port 853 < 1024 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
LimitNOFILE=65535
# magazine cache (100M) + rustls/quinn overhead, hard ceiling
MemoryMax=400M
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
