# magdns - private DoT/DoQ relay for the home box
# /etc/magdns/magdns.conf

# dual-stack listeners ([::] with v6only=0 serves v4-mapped too)
listen_dot = [::]:853
listen_doq = [::]:8853

# certificate for the listeners (see README: Let's Encrypt via http-01)
cert_file = /etc/magdns/cert.pem
key_file = /etc/magdns/key.pem

# foreign chain: three DoH springs in load-sharing balance
# (spread_upstreams=true below rotates them round-robin; a source that
# fails twice is struck out and probed back in background).
# Flags after the URL:
#   noecs — this source ignores EDNS Client Subnet (Quad9): ECS-carrying
#           queries route around it, so geo answers stay geo-correct
#   h2    — multiplex over HTTP/2 with a 4-connection fan-out; use for
#           near-edge relays (Maker), not for transoceanic direct sources
upstream = https://dns.google/dns-query
upstream = https://dns9.quad9.net/dns-query noecs
upstream = https://unfiltered.adguard-dns.com/dns-query
# self-hosted Maker relay in front of Google: h2 multiplexing + relay auth
# upstream = https://pure-dns.isui.ren/dns-query h2
# maker_auth_kind = token          # "token" -> raw `token:` header,
# maker_auth_key = <your-token>    # "bearer" -> Authorization: Bearer <key>

allow_private_upstream = false

# magazine cache: RAM only, FIFO tail eviction, per-entry lifetime cap
cache_bytes = 104857600
cache_ttl = 1200

# per-query total budget and per-source attempt budget (ms)
query_timeout_ms = 3000
attempt_timeout_ms = 1500
# health-probe cadence for sources marked down (s)
probe_interval_s = 12
# idle timeout for client connections (ms)
idle_timeout_ms = 45000

# split routing: CN domains (cn_domain_file list) resolve through these
# domestic legs — plain udp://, round-robin fan-out across legs with
# single-flight merge of identical concurrent queries; two strikes mark a
# leg down, background probes bring it back. TC=1 answers retry over TCP.
# 223.5.5.5/223.6.6.6 (AliDNS) pass ECS through; 114 does not -> noecs.
cn_upstream = udp://223.5.5.5:53
cn_upstream = udp://223.6.6.6:53
cn_upstream = udp://114.114.114.114:53 noecs
cn_domain_file = /etc/magdns/accelerated-domains.china.conf

# layered rate limiting, all token buckets; rate = 0 disables that layer.
# SIGHUP applies new values live (changing limits resets the buckets).
qps_per_ip = 50
burst_per_ip = 100
# whole-process arrival ceiling protecting upstreams + bandwidth
qps_global = 5000
burst_global = 10000
# aggregate per-qname cap so one hot domain cannot crowd out the rest;
# at most domain_limit_entries distinct names are tracked (~bounded RAM)
qps_domain = 100
burst_domain = 200
domain_limit_entries = 8192
# hard cap on queries being processed at once (overload drops instead of OOM)
max_concurrent_queries = 1024
# rotate the alive-source start per query in the FOREIGN chain too
# (load-sharing across the three DoH springs; CN pool always spreads)
spread_upstreams = true

# verbose = false
# log_queries = false
