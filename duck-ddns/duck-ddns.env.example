# /etc/duck-ddns.env
# token: the UUID shown on the duckdns.org homepage after login
TOKEN=00000000-0000-0000-0000-000000000000
# subdomains without .duckdns.org; comma-separated (all get the same IPs)
DOMAINS=example123
# interface with an IPv6 default route; empty = auto-detect via
# `ip -6 route show default`
IFACE=
# poll interval in seconds (DuckDNS only asks for <= 1 update per minute)
INTERVAL=300
